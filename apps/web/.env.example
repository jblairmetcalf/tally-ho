# Family sync (Firebase). Copy to apps/web/.env.local and fill in from
# Firebase console → Project settings → General → Your apps → the web app's config.
# These values are not secrets: they identify the project, and firestore.rules guards the data.
# Leave them unset to build a demo-only app (no sign-in).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Link previews (iMessage, Slack, WhatsApp) need absolute URLs. Set this when the app lives
# somewhere other than https://tally-ho-pwa.vercel.app (the default).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Tests only: talk to the local emulators (Auth :9099, Firestore :8080, project demo-tally).
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
