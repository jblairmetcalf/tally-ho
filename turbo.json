{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "storybook-static/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {}
  }
}
